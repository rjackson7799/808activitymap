# ── Brand / domain (D27: undecided — never hardcode; all references flow from here) ──
BRAND_NAME="Portal (dev)"
PORTAL_DOMAIN="localhost:3000"

# ── Supabase ──
# Local dev values are printed by `supabase start` (`supabase status`).
NEXT_PUBLIC_SUPABASE_URL="http://127.0.0.1:54331"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# Server-only. Never exposed to the client; public pages read via server-side
# functions only (ADR-004 anon deny-all).
SUPABASE_SERVICE_ROLE_KEY=""
# Direct Postgres connection for migrations/tests (local default shown).
# Ports use the 5433x block — 5432x is occupied by another local project.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54332/postgres"

# ── Environment ──
# local | test | staging | production — drives fail-closed config behavior (§23).
# Defaults exist only when local/test is explicit. Staging/production require
# every value and reject the documented development literals.
APP_ENV="local"

# ── Analytics / scheduled maintenance (CP5) ──
# Server-only HMAC pepper for irreversible analytics IP rate-limit subjects.
# Staging/production: provision a unique high-entropy value in the managed store.
IP_HASH_PEPPER=""
# Server-only token used only by the public proxy when posting authoritative
# first-party events to /api/events. Staging/production: generate a distinct
# high-entropy value; the local/test development literal is rejected there.
EVENTS_INTERNAL_TOKEN=""
# Server-only, deployment-local origin used for the internal /api/events call.
# Staging/production require a bare HTTPS origin (no path/query/credentials).
EVENTS_INGEST_ORIGIN="http://127.0.0.1:3000"
# Vercel Cron bearer secret for /api/cron/* maintenance routes. Staging and
# production require a distinct high-entropy managed value.
CRON_SECRET=""
# Optional observability seam. No Sentry SDK is installed in CP5; leave blank
# until a provider is approved and configured.
SENTRY_DSN=""

# ── super_admin provisioning (CP2, ADR-001) ──
# Consumed ONLY by `npm run provision:super-admin` (script-local schema, not
# the app env). Per-environment credentials — never a known password in
# staging/prod, never committed. The script is idempotent.
SUPER_ADMIN_EMAIL=""
SUPER_ADMIN_PASSWORD=""
